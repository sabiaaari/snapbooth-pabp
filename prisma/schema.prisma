// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  password      String?   // Opsional agar nanti bisa menampung akun Login Google juga
  emailVerified DateTime? // Terisi otomatis setelah user klik link verifikasi email
  image         String?
  accounts      Account[]
  sessions      Session[]
  // Biarkan relasi tabel Snapbooth milikmu (misal: templates Template[]) tetap di sini
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Template {
  id              String   @id @default(cuid())
  name            String
  image_url       String // URL ke frame PNG di Supabase Storage
  required_photos Int // Jumlah slot foto (menggantikan 'slots')
  is_system       Boolean  @default(false)
  color           String? // Warna background untuk UI list template
  user_id         String? // ID dari Supabase Auth pengguna yang login
  created_at      DateTime @default(now())

  // Relasi: Satu template bisa memiliki banyak hasil foto
  results Result[]
}

model Result {
  id         String   @id @default(cuid())
  photo_url  String // URL ke hasil foto gabungan akhir di Storage
  created_at DateTime @default(now())

  // Relasi kembali ke Template mana yang dipakai
  template_id String
  template    Template @relation(fields: [template_id], references: [id])
}
